# Cargo output and diagnostics. Cargo.lock is committed for reproducible builds.
/target/
**/*.rs.bk
*.pdb
rustc-ice-*.txt
**/mutants.out*/

# Native release outputs staged at the repository root.
/artifact/
/release-assets/
/BatteryBridge-*.pkg
/BatteryBridge-*.exe
/BatteryBridge-*.deb
/BatteryBridge-*.rpm
/batterybridge-*.tar.gz
/batterybridge-*.zip
/SHA256SUMS.txt
/release-notes.md

# Python packaging tools and local verification caches.
__pycache__/
*.py[cod]
.playwright-mcp/

# Local OS files and editor state.
.DS_Store
Thumbs.db
.idea/

# Legacy frontend caches, if present in an older working tree.
node_modules/
/apps/gui/dist/
